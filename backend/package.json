{
  "name": "unievents-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "env:setup": "node scripts/ensure-env.mjs",
    "postinstall": "node scripts/run-prisma.mjs generate",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:migrate": "node scripts/run-prisma.mjs migrate dev",
    "prisma:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "prisma:seed": "node scripts/run-prisma.mjs db seed",
    "db:setup": "node scripts/run-prisma.mjs migrate deploy && node scripts/run-prisma.mjs db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
